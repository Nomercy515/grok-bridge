# Copy to data/grok-bridge.env (gitignored). Never commit real values.
GROK_BRIDGE_AGENT=bot
GROK_BRIDGE_AGENT_MODE=webhook
GROK_BRIDGE_HOST=127.0.0.1
GROK_BRIDGE_PORT=4020
GROK_BRIDGE_SECRET=
GROK_BRIDGE_AGENT_WEBHOOK_URL=
GROK_BRIDGE_AGENT_WEBHOOK_AUTH=
GROK_BRIDGE_CALLBACK_BASE=https://<machine>.<tailnet>.ts.net:4020
GROK_BRIDGE_AGENT_TIMEOUT=180
GROK_BRIDGE_DATA=./data

# Optional: on-disk Grok Build sessions (list + open + live send via ACP).
# Resolution order (never hardcode OS/user paths in code):
#   1) GROK_BRIDGE_GROK_HOME
#   2) GROK_HOME
#   3) $HOME/.grok
# Layout: $GROK_HOME/sessions/<url.PathEscape(cwd)>/<session-id>/{summary.json,chat_history.jsonl}
# If unset/missing, hub-native data/sessions/ still works; Build list is empty.
GROK_BRIDGE_GROK_HOME=
# GROK_HOME=
# Show agent-to-agent Build sessions (subagent / no human turn). Default off.
# GROK_BRIDGE_INCLUDE_GROK_ONLY=1

# Grok Build ACP agent (live send/resume). Default ws://127.0.0.1:2419/ws
# Start agent: grok agent --always-approve --no-leader serve --bind 127.0.0.1:2419 --secret <token>
GROK_BRIDGE_GROK_AGENT_WS=ws://127.0.0.1:2419
GROK_BRIDGE_GROK_AGENT_SECRET=
# Optional fallback secret name used by grok itself:
# GROK_AGENT_SECRET=
# When 1, Bridge will try `grok` on PATH to spawn serve if unreachable (never hardcodes WSL paths).
GROK_BRIDGE_GROK_AGENT_AUTO_START=0
# Bind used only for auto-start / error hints:
# GROK_BRIDGE_GROK_AGENT_BIND=127.0.0.1:2419
